# === Server ===
PORT=8080
GIN_MODE=debug  # debug | release

# === Database ===
# Local: postgres://user:password@localhost:5432/canine_advisor?sslmode=disable
# Supabase: postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgres://user:password@localhost:5432/canine_advisor?sslmode=disable

# === Google ADK / Gemini ===
GOOGLE_API_KEY=your-google-api-key
GEMINI_MODEL=gemini-2.5-flash

# === Session ===
SESSION_TIMEOUT_MIN=30

# === Tier ===
DEFAULT_MAX_ITEMS=30

# === KakaoTalk ===
KAKAO_SKILL_API_KEY=your-kakao-skill-api-key

# === Webview ===
WEBVIEW_BASE_URL=http://localhost:3000
